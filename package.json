{
  "name": "sonic_wave",
  "productName": "SonicWave",
  "version": "1.0.0",
  "description": "SonicWave music player by Anish TayiN",
  "author": "Anish TayiN",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.example.sonicwave",
    "productName": "SonicWave",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "build/web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SonicWaveSetup.exe"
    }
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  }
}
